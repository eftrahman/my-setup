/* Tech Console — compact, information-dense Waybar layout */
{
  "include": [
    "$HOME/.config/waybar/Modules",
    "$HOME/.config/waybar/ModulesWorkspaces",
    "$HOME/.config/waybar/ModulesCustom",
    "$HOME/.config/waybar/ModulesGroups",
    "$HOME/.config/waybar/UserModules"
  ],

  "layer": "top",
  "position": "top",
  "height": 30,
  "exclusive": true,
  "passthrough": false,
  "fixed-center": true,
  "ipc": true,
  "spacing": 0,
  "margin-top": 4,
  "margin-bottom": 4,
  "margin-left": 10,
  "margin-right": 10,

  "modules-left": [
    "group/app_drawer",
    "hyprland/window#tech"
  ],

  "modules-center": [
    "hyprland/workspaces#tech"
  ],

  "modules-right": [
    "cpu#tech",
    "memory#tech",
    "temperature#tech",
    "battery",
    "network#tech",
    "pulseaudio#tech",
    "tray#tech",
    "group/notify",
    "custom/weather",
    "idle_inhibitor#tech",
    "clock#tech",
    "custom/nightlight",
    "group/status"
  ],

  "hyprland/window#tech": {
    "format": "󰘔  {}",
    "max-length": 32,
    "separate-outputs": true,
    "rewrite": {
      "(.*) — Mozilla Firefox": "  $1",
      "(.*) - Google Chrome": "  $1",
      "(.*) - zsh": "  $1",
      "(.*) - fish": "  $1"
    }
  },

  "hyprland/workspaces#tech": {
    "all-outputs": true,
    "sort-by-number": true,
    "show-special": false,
    "on-click": "activate",
    "on-scroll-up": "hyprctl dispatch workspace e+1",
    "on-scroll-down": "hyprctl dispatch workspace e-1",
    "persistent-workspaces": {
      "*": 5
    },
    "format": "{name}"
  },

  "cpu#tech": {
    "interval": 2,
    "format": "󰍛 {usage:02}%",
    "states": {
      "warning": 70,
      "critical": 90
    },
    "tooltip-format": "CPU load: {usage}%\nRight-click: system monitor",
    "on-click-right": "gnome-system-monitor"
  },

  "memory#tech": {
    "interval": 5,
    "format": "󰘚 {percentage:02}%",
    "states": {
      "warning": 75,
      "critical": 90
    },
    "tooltip-format": "Memory: {used:0.1f} / {total:0.1f} GiB\nRight-click: btop",
    "on-click-right": "$HOME/.config/hypr/scripts/WaybarScripts.sh --btop"
  },

  "temperature#tech": {
    "interval": 5,
    "hwmon-path": [
      "/sys/class/hwmon/hwmon1/temp1_input",
      "/sys/class/thermal/thermal_zone0/temp"
    ],
    "critical-threshold": 82,
    "format": " {temperatureC}°",
    "format-critical": "󰸁 {temperatureC}°",
    "tooltip-format": "System temperature: {temperatureC}°C\nRight-click: nvtop",
    "on-click-right": "$HOME/.config/hypr/scripts/WaybarScripts.sh --nvtop"
  },

  "network#tech": {
    "interval": 2,
    "format-wifi": "{icon}   {bandwidthDownBytes}",
    "format-ethernet": "󰈀   {bandwidthDownBytes}",
    "format-linked": "󰈁 LINK",
    "format-disconnected": "󰤭 OFFLINE",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "tooltip-format-wifi": "{essid}  •  {signalStrength}%\n{ipaddr}\nDownload: {bandwidthDownBytes}\nUpload: {bandwidthUpBytes}",
    "tooltip-format-ethernet": "{ifname}\n{ipaddr}\nDownload: {bandwidthDownBytes}\nUpload: {bandwidthUpBytes}",
    "tooltip-format-disconnected": "Network disconnected\nRight-click: network manager",
    "on-click-right": "$HOME/.config/hypr/scripts/WaybarScripts.sh --nmtui"
  },

  "pulseaudio#tech": {
    "format": "{icon} {volume}%",
    "format-bluetooth": "󰂰 {volume}%",
    "format-muted": "󰖁 MUTED",
    "format-icons": {
      "headphone": "",
      "headset": "",
      "default": ["", "", "󰕾", ""]
    },
    "scroll-step": 5,
    "on-click": "$HOME/.config/hypr/scripts/Volume.sh --toggle",
    "on-click-right": "pavucontrol -t 3",
    "on-scroll-up": "$HOME/.config/hypr/scripts/Volume.sh --inc",
    "on-scroll-down": "$HOME/.config/hypr/scripts/Volume.sh --dec",
    "tooltip-format": "{desc}\nVolume: {volume}%"
  },

  "tray#tech": {
    "icon-size": 15,
    "spacing": 6
  },

  "idle_inhibitor#tech": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰈈",
      "deactivated": "󰈉"
    },
    "tooltip-format-activated": "Focus mode: screen will stay awake\nClick to disable",
    "tooltip-format-deactivated": "Focus mode: normal idle behavior\nClick to keep screen awake"
  },

  "clock#tech": {
    "interval": 1,
    "format": "󰥔 {:%H:%M}",
    "format-alt": "󰃭 {:%a %d %b  %H:%M:%S}",
    "format-alt-click": "click",
    "tooltip-format": "<big>{:%A, %d %B %Y}</big>\n<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#b991ff'><b>{}</b></span>",
        "days": "<span color='#d8e2ff'>{}</span>",
        "weekdays": "<span color='#5ee7f7'><b>{}</b></span>",
        "today": "<span color='#78f0c2'><b><u>{}</u></b></span>"
      }
    }
  }
}
